<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Shop | E-Commerce</title>
    <link rel="stylesheet" href="style.css">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- Header / Navigation -->
    <header>
        <div class="navbar container">
            <div class="logo">Modern<span>Shop</span></div>
            <nav>
                <ul class="nav-links">
                    <li><a href="#" class="active">Home</a></li>
                    <li><a href="#">Products</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>
            </nav>
            <div class="cart-icon" id="cart-icon-btn">
                <i class="fas fa-shopping-bag"></i>
                <span id="cart-count">0</span>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content container">
            <h1>Upgrade Your Style</h1>
            <p>Discover our curated collection of premium essentials designed for modern life.</p>
            <a href="#products" class="btn">Shop Collection</a>
        </div>
    </section>

    <!-- Main Products Section -->
    <main class="container" id="products">
        <h2 class="section-title">Featured Products</h2>
        <div class="product-grid" id="product-grid">
            <!-- Products will be dynamically inserted by JavaScript -->
        </div>
    </main>

    <!-- Shopping Cart Sidebar -->
    <div class="cart-sidebar" id="cart-sidebar">
        <div class="cart-header">
            <h3>Your Cart</h3>
            <i class="fas fa-times close-cart" id="close-cart"></i>
        </div>
        <div class="cart-body" id="cart-items-container">
            <!-- Cart items will appear here -->
            <p class="empty-message">Your cart is empty.</p>
        </div>
        <div class="cart-footer">
            <div class="total-price-box">
                <span>Total:</span>
                <span id="cart-total">$0.00</span>
            </div>
            <button class="checkout-btn" id="checkout-btn">Proceed to Checkout</button>
        </div>
    </div>
    
    <!-- Overlay for Cart -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 ModernShop. All rights reserved.</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
